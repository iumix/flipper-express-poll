# For details & more options, see documentation/AppManifests.md in the firmware repo

App(
    appid="apple_pay_express_poll",
    name="Apple Pay Express Poll",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="express_poll_app",
    requires=["gui", "storage", "notification"],
    stack_size=4 * 1024,
    # Host unit tests are not part of the .fap
    sources=["*.c", "!tests"],
    fap_category="NFC",
    fap_version="0.1",
    fap_icon="express_poll.png",  # 10x10 1-bit PNG
    fap_description="Triggers Apple Pay Express Mode via FeliCa polling, ECP, or T-Money NFC-A, with read-only balances",
    fap_author="iumix",
)
